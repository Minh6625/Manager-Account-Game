{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/api/src/*"],
      "@manager-acc/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["api/**/*.ts", "apps/api/src/**/*.ts", "packages/shared/src/**/*.ts"]
}
