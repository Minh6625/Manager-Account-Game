# Database (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (CORS + links in emails)
FRONTEND_URL=http://localhost:5173

# ---------- Email (invitation + welcome) ----------
# EMAIL_ENABLED:
#   true  → gửi SMTP (cần SMTP_HOST)
#   false → chỉ log ra console (dev)
#   (unset) → tự bật nếu có SMTP_HOST, không thì log
EMAIL_ENABLED=false

MAIL_FROM="Manager Account Liên Quân <tranvanminhk16@siu.edu.vn>"

# SMTP (Gmail app password, Mailtrap, Resend SMTP, v.v.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
