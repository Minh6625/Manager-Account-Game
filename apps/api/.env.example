# Database (Supabase / Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT — use a long random string in production
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (CORS + email links)
# Local:  http://localhost:5173
# Prod:   https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ---------- Email (invitation + welcome) ----------
# EMAIL_ENABLED:
#   true   → send via SMTP (needs SMTP_HOST)
#   false  → log only (dev)
#   unset  → auto-enable if SMTP_HOST is set
EMAIL_ENABLED=false

MAIL_FROM="Manager Account <noreply@example.com>"

# SMTP (Gmail app password, Mailtrap, Resend, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
