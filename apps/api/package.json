{
  "name": "@manager-acc/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc",
    "start": "node dist/app/server.js",
    "prisma:generate": "prisma generate --schema=./src/infra/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./src/infra/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./src/infra/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/infra/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "express": "^4.18.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "cookie-parser": "^1.4.0",
    "cors": "^2.8.0",
    "dotenv": "^16.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/cors": "^2.8.0",
    "@types/node": "^20.0.0",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
